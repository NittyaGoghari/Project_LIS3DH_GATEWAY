&pinctrl {
    uart0_default: uart0_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 29)>,
                    <NRF_PSEL(UART_RX, 0, 28)>;
        };
    };

    uart0_sleep: uart0_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 0, 29)>,
                    <NRF_PSEL(UART_RX, 0, 28)>;
            low-power-enable;
        };
    };

    i2c0_default: i2c0_default {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 2)>,
                    <NRF_PSEL(TWIM_SCL, 0, 3)>;
        };
    };

    i2c0_sleep: i2c0_sleep {
        group1 {
            psels = <NRF_PSEL(TWIM_SDA, 0, 2)>,
                    <NRF_PSEL(TWIM_SCL, 0, 3)>;
            low-power-enable;
        };
    };
};


&uart0 {
    status = "okay";
    current-speed = <115200>;
    pinctrl-0 = <&uart0_default>;
    pinctrl-1 = <&uart0_sleep>;
    pinctrl-names = "default", "sleep";
};
/ {
    /* Define the LEDs used in your code */
    leds {
        compatible = "gpio-leds";

        /* Satisfies DT_NODELABEL(led0) */
        led0: led_0 {
            gpios = <&gpio0 4 GPIO_ACTIVE_LOW>; /* Schematic LED1 (Blue) */
            label = "Status LED 0";
        };

        /* Satisfies DT_NODELABEL(led3) */
        led3: led_3 {
            gpios = <&gpio0 5 GPIO_ACTIVE_LOW>;  /* Schematic LED3 (Green) */
            label = "Status LED 3";
        };
    };

    /* Define the Button used in your code */
    buttons {
        compatible = "gpio-keys";

        /* Satisfies DT_NODELABEL(button0) */
        button0: button_0 {
            gpios = <&gpio0 20 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>; /* Schematic Button 1 */
            label = "Main Button";
        };
    };
};

/* Enable I2C0 and define the Accelerometer */




&i2c0 {
    compatible = "nordic,nrf-twim";
    status = "okay";
    clock-frequency = <I2C_BITRATE_STANDARD>;
    lis2dh@19 {
        status = "okay";
        compatible = "st,lis2dh";
        reg = <0x19>;
        label = "LIS2DH";
    };
};
